NODE_ENV=development
PORT=5000
# PostgreSQL connection string from your provider. Neon connection strings use SSL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Optional source database path for the one-time SQLite import only.
SQLITE_PATH=
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash-from-npm-run-admin:hash
VITE_API_BASE_URL=
